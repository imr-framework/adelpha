{
  "name": "adelpha-digital-twin",
  "private": true,
  "version": "0.1.0",
  "description": "Adelpha digital twin observer GUI for DTAM",
  "author": "Adelpha / Geethanath lab",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps",
    "electron:dev": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:mac:dir": "npm run build && electron-builder --mac --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --arm64 --config.npmRebuild=false",
    "dist:linux": "npm run build && bash electron/build-linux.sh"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "three": "^0.170.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "org.adelpha.digital-twin-ui",
    "productName": "Adelpha Digital Twin",
    "copyright": "Copyright © Adelpha / Geethanath lab",
    "directories": {
      "output": "release",
      "buildResources": "electron/build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "dist/**"
    ],
    "afterPack": "electron/afterPack.cjs",
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "icon": "electron/build/icon.png",
    "mac": {
      "icon": "electron/build/icon.icns",
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSCameraUsageDescription": "Adelpha uses the camera for optional head-pose tracking in the twin viewport."
      }
    },
    "dmg": {
      "title": "Adelpha Digital Twin"
    },
    "win": {
      "icon": "electron/build/icon.png",
      "executableName": "AdelphaDigitalTwin",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64", "arm64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adelpha Digital Twin"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "electron/build/icon.png",
      "category": "Education",
      "executableName": "adelpha-digital-twin",
      "maintainer": "Adelpha / Geethanath lab <2021BME060@std.must.ac.ug>",
      "synopsis": "Adelpha digital twin observer GUI for DTAM",
      "desktop": {
        "entry": {
          "Name": "Adelpha Digital Twin",
          "Comment": "The Intelligent Magnetic Resonance Framework"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ]
    }
  }
}
