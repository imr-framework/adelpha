# Mesh must live in public/ — URL is from site root, not a full disk path.
# VITE_MAGNET_CAD_URL=/MRI_base.stl
# VITE_MAGNET_CAD_SCALE=0.001
# VITE_MAGNET_CAD_RY_DEG=90

# --- DTAM backends (start these in the DTAM repo, not here) ---
# Twin HTTP API:   cd ../dtam && make twin-api      → http://127.0.0.1:8080
# Agents API:      cd ../dtam && make agents-api    → http://127.0.0.1:8001
# Agents need GOOGLE_API_KEY in the DTAM process env (e.g. DTAM root .env).

# Twin HTTP API — Vite rewrite proxy (recommended)
VITE_DTAM_API_URL=/api/dtam
# Direct (requires CORS): VITE_DTAM_API_URL=http://127.0.0.1:8080

# Google ADK agent API — Vite rewrite proxy (recommended)
VITE_ADK_API_URL=/api/agents
# Direct: VITE_ADK_API_URL=http://127.0.0.1:8001
VITE_ADK_APP_NAME=dtam
VITE_ADK_USER_ID=gui-user
# Optional model picker defaults (id:Label,comma-separated)
# VITE_ADK_MODELS=gemini-2.5-flash:2.5 Flash,gemini-2.5-pro:2.5 Pro
# VITE_ADK_MODEL=gemini-2.5-flash
